    <!-- MCP server -->
    <string name="section_mcp">MCP server</string>
    <string name="setting_mcp">Turn on the MCP server</string>
    <string name="setting_mcp_hint">Lets AI tools on your computer (Claude Code, Cursor and others) give this phone tasks over MCP, or look at the screen and operate it themselves. Listens on port %d while on; every request needs the access token.</string>
    <string name="setting_mcp_lan">Allow LAN access</string>
    <string name="setting_mcp_lan_hint">When off, it only listens on the phone itself; connect from the computer with adb forward. When on, devices on the same network can connect directly, over plain HTTP.</string>
    <string name="confirm_mcp_lan_title">Allow LAN access?</string>
    <string name="confirm_mcp_lan">Every device on this network can reach the port. The connection is plain HTTP, so others on the network may capture the token, and the token is enough to control this phone. Only turn this on in networks you trust.</string>
